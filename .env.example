# Copy to .env (same directory as docker-compose.example.yaml) and chmod 600.
# Real secrets live ONLY here, never in the committed compose/yaml.

# Pin the Bulwark image version — never rely on :latest.
BULWARK_VERSION=v0.1.0

# Host address the dashboard/API binds to. Secure default: loopback only.
# Put Bulwark behind a reverse proxy for LAN/remote access. Never 0.0.0.0.
BULWARK_BIND_ADDR=127.0.0.1

# Bearer token for the API + dashboard (set api.auth.type: bearer in
# bulwark.yaml). Generate with: openssl rand -hex 32
BULWARK_API_TOKEN=replace-with-openssl-rand-hex-32
